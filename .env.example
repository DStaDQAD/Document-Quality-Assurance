LLM_PROVIDER=groq

# Vision provider for PDF image extraction (used when PDF has no text layer).
# "google" → Gemini (default), "groq" → llama-4-scout via Groq API.
VISION_PROVIDER=groq

# Pages sent per vision LLM call. Fewer, larger calls beat many small ones under a
# requests-per-minute cap (Gemini free tier ≈ 5 rpm). 0 = per-provider auto: Gemini
# batches 3/call, Groq (token-throttled) and local providers stay 1/call. Set e.g. 3
# to force batching on any provider.
VISION_PAGES_PER_CALL=0

# Pages per vision call when TRANSCRIBING TABLES out of a PDF (internal mode). A separate
# knob from VISION_PAGES_PER_CALL above, which covers reading narrative text off page images.
# Left at 1 deliberately: a Lampiran page is roughly 40 rows x 14 columns, and batching two of
# them risks the model's output being truncated mid-table. That is the worst failure here - a
# dropped row is invisible downstream, whereas a failed call is logged and skipped.
PDF_TABLE_PAGES_PER_CALL=1

# How many vision calls may run at once against Gemini. The default of 4 fits the FREE tier's
# 5 requests/minute. On a paid tier raise it (8-12): a scanned ten-page report then finishes in
# one wave of calls instead of three. Only affects Gemini; Groq is serialised (token-throttled)
# and local providers are unthrottled.
GEMINI_VISION_CONCURRENCY=4

# Ollama (runs locally, no API key needed - good default for free local testing)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Groq (used when LLM_PROVIDER=groq or VISION_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MAX_TOKENS=8192

# Google AI Studio / Gemini (used when LLM_PROVIDER=google or VISION_PROVIDER=google)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MAX_OUTPUT_TOKENS=0  # 0 = use model default (recommended)

# Gemini 2.5 spends "thinking" tokens on internal reasoning by default, which multiplies
# per-call latency several-fold. Every Gemini call in this pipeline (reading text off page
# images, extracting facts to a schema, typo verdicts) is pattern matching rather than
# multi-step reasoning, so thinking is disabled by default. Use -1 for the model's own dynamic
# default, or a positive token cap.
# CAREFUL: gemini-2.5-pro cannot disable thinking and REJECTS 0 - if you point GEMINI_MODEL at
# pro, set this to -1 or >=128 first, or every call fails.
GEMINI_THINKING_BUDGET=0

DATABASE_PATH=statistik_makro.db

# Access control - a signed session cookie, NOT HTTP Basic. /api/login checks these two
# values and sets an HttpOnly cookie (dqa_session, valid 12 hours); the middleware then
# requires it on /api/* and answers 401 without it. What stays open: the app shell
# (index.html, which shows the login overlay itself), /health, and the auth endpoints.
# Set BOTH to require a login; leave either blank to disable auth entirely (local dev and
# tests). On the host, set these as Secrets, not here.
APP_USERNAME=
APP_PASSWORD=

# Key the session cookie is signed with. Optional: left blank it is derived from
# APP_USERNAME:APP_PASSWORD, so no extra Secret is needed - but then changing the password
# also invalidates every session already signed in. Set it explicitly to keep the two apart.
SESSION_SECRET=
